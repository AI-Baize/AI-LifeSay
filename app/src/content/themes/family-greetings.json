          "support_zh": "先留几秒回应时间，需要时再示范。"
        },
        {
          "level": 2,
          "title_zh": "换个场景",
          "support_zh": "在不同场景尝试相同目标，需要帮助仍如实记录。"
        }
      ],
      "steps": [
        {
          "id": "meet",
          "title_zh": "玩偶出现",
          "seconds": 60,
